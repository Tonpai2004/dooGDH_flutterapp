<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/watchingRoot"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ปุ่มย้อนกลับ -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <!-- ส่วนของการเล่นวิดีโอ -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ปุ่ม "รับชมภาพยนตร์" -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="กดรับชมภาพยนตร์"
        android:backgroundTint="#9D161515"
        android:fontFamily="@font/mitr"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/videoView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- ข้อความใต้ปุ่ม "รับชมภาพยนตร์" -->
    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="หมุนโทรศัพท์ในแนวนอน ก่อนกดรับชม"
        android:fontFamily="@font/mitrbold"
        android:textColor="#000000"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ชื่อภาพยนตร์ -->
    <TextView
        android:id="@+id/movieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="น้อง.พี่.ที่รัก"
        android:textSize="24sp"
        android:fontFamily="@font/mitr"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/messageText"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- เรื่องย่อภาพยนตร์ -->

    <TextView
        android:id="@+id/movieDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/mitr"
        android:text="ตั้งแต่เด็ก 'ชัช' คิดมาตลอดว่าน้องที่อยู่ในท้องแม่คือ น้องชาย พอถึงวันที่แม่คลอดแล้วกลายเป็นน้องสาว ชัชจึงเซ็งระดับสิบ ความฝันที่จะได้เล่นหุ่นยนต์และเตะบอลแมนๆกับน้องก็จบไป เพราะเล่นกับไอ้ 'เจน' ทีไร มันก็ร้องไห้งอแงทุกที ตั้งแต่เด็กจนโต ชัชกับเจนตีกันได้ทุกเรื่อง เพราะเจนชอบทำตัวเหมือนเป็นแม่มากกว่าเป็นน้อง ส่วนชัชก็ชอบทำตัวเป็นภาระมากกว่าเป็นพี่ จะมีพี่ชายคนไหนที่ห่วยกว่าน้องสาวไปซะทุกด้าน ไม่ว่าจะเป็นเรื่องการเรียน กีฬา หน้าตา นิสัย แข่งกันยังไง เจนก็เพอร์เฟคกว่า เวลาเดียวที่ชัชจะโชว์เหนือทำตัวเป็นพี่ ก็คือตอนที่มีคนมาจีบเจน ชัชจะทำตัวกร่างไล่หนุ่มๆให้หนีหายไปหมด เหมือนเป็นการเอาคืน นั่นจึงเป็นเหตุผลที่เจนต้องปิดบังความรักระหว่างเธอกับ 'โมจิ' ชายหนุ่มลูกครึ่งญี่ปุ่น สุดเพอร์เฟค เพราะเจนไม่อยากให้รักครั้งนี้ต้องพังยับด้วยน้ำมือของพี่ชัชเหมือนที่ผ่านมา แต่ความรักไม่ใช่ความลับ ชัชรู้จนได้ว่าเจนกับโมจิแอบคบกัน แล้วมีเหรอที่ชัชจะยอมปล่อยผ่าน ก็บอกแล้วว่าอะไรที่ทำให้น้องมีความสุข พี่ชายที่แสนดีอย่างชัชจะไม่มีวันยอมให้เกิดขึ้นแน่นอน!! "
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieTitle" />

    <!-- ปุ่ม อ่านเพิ่มเติม / ซ่อน -->
    <TextView
        android:id="@+id/toggleReadMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="อ่านเพิ่มเติม"
        android:textColor="@color/black"
        android:fontFamily="@font/mitrbold"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription"/>

    <!-- ส่วนเลื่อนของนักแสดงและผู้กำกับ -->

    <TextView
        android:id="@+id/castAndDirectorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/mitr"
        android:text="นักแสดงและผู้กำกับ"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription" />

    <HorizontalScrollView
        android:id="@+id/castAndDirectorScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/castAndDirectorTitle">

        <!-- LinearLayout ภายใน HorizontalScrollView เพื่อใส่ภาพนักแสดงและผู้กำกับ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/brodir"
                    android:contentDescription="Director 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="วิทยา ทองอยู่ยง (ผู้กำกับ)"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/bro1"
                    android:contentDescription="Actor 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ซันนี่ สุวรรณเมธานนท์"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/bro2"
                    android:contentDescription="Actor 2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="อุรัสยา เสปอร์บันด์"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/bro3"
                    android:contentDescription="Actor 3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="นิชคุณ หรเวชกุล"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ปุ่ม "ออกจากโหมดเต็มจอ" -->
    <ImageButton
        android:id="@+id/exitFullScreenButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/baseline_crop_free_24"
        android:contentDescription="Exit Full Screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:visibility="gone" /> <!-- ซ่อนตอนแรก -->
</androidx.constraintlayout.widget.ConstraintLayout>

