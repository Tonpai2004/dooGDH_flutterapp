<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/watchingRoot"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ปุ่มย้อนกลับ -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <!-- ส่วนของการเล่นวิดีโอ -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ปุ่ม "รับชมภาพยนตร์" -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="กดรับชมภาพยนตร์"
        android:backgroundTint="#9D161515"
        android:fontFamily="@font/mitr"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/videoView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- ข้อความใต้ปุ่ม "รับชมภาพยนตร์" -->
    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="หมุนโทรศัพท์ในแนวนอน ก่อนกดรับชม"
        android:fontFamily="@font/mitrbold"
        android:textColor="#000000"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ชื่อภาพยนตร์ -->
    <TextView
        android:id="@+id/movieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOMESTAY โฮมสเตย์"
        android:textSize="24sp"
        android:fontFamily="@font/mitr"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/messageText"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- เรื่องย่อภาพยนตร์ -->

    <TextView
        android:id="@+id/movieDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/mitr"
        android:text="'มึงได้รางวัลนะ' ผู้ชายท่าทางลึกลับที่เรียกตัวเองว่า 'ผู้คุม' บอกผม ในขณะที่เรายืนประจันหน้ากันบนผนังตึกของโรงพยาบาลที่หมุนพลิกราวกับแรงโน้มถ่วงกลับด้าน! ผู้คุมไม่รอให้ผมปะติดปะต่อเรื่องราวในหัว เขากระชากคอเสื้อผมให้มาฟังคำอธิบายถึงรางวัลที่วิญญาณเร่ร่อนอย่างผมได้รับ นั่นก็คือการได้กลับมามีชีวิตอีกครั้งในร่างของเด็กม.ปลายที่ชื่อ 'มิน' ที่นอนนิ่งอยู่ในตู้เก็บศพของโรงพยาบาลแห่งนี้ จะว่าไปการได้มาอยู่ในร่างใหม่ ก็ไม่ต่างอะไรกับการอยู่โฮมสเตย์ คืออยู่ได้แค่ชั่วคราว แถมยังไม่ได้อยู่ฟรีๆ เพราะผมต้องหาคำตอบให้ได้ภายใน 100 วัน ว่า “มินตายเพราะใคร” ถ้าตอบไม่ได้ ผมจะต้องตายและจากร่างโฮมสเตย์นี้ไปตลอดกาล เอาเข้าจริงๆ ผมก็ไม่คิดว่าจะอินกับการอยู่ในร่างโฮมสเตย์นี้ซักเท่าไหร่ การมีครอบครัวใหม่ มีเพื่อนใหม่ ก็ไม่ทำให้หัวใจเต้นแรงเท่าการได้มีความรักครั้งใหม่ ผมได้รู้จักกับ 'พาย' พี่รหัสของมิน ผู้หญิงที่ทำให้ผมอยากอยู่ในร่างโฮมสเตย์นี้ตลอดไป แต่เวลา ชีวิต และความรัก เป็นเหมือนรางวัลที่สวรรค์ให้ผมมาแค่ชั่วคราว ผมจึงต้องทำทุกวิถีทางเพื่อตอบคำถามผู้คุมให้ได้ว่า “มินตายเพราะใคร” ก่อนที่เวลาชีวิตในร่างโฮมสเตย์ของผมจะหมดลง....พบภาพยนตร์ทริลเลอร์แฟนตาซีเรื่องแรกของ GDH ที่ดัดแปลงเรื่องราวมาจากวรรณกรรมญี่ปุ่นที่อยู่ในดวงใจใครหลายคน ประพันธ์โดย Eto Mori"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieTitle" />

    <!-- ปุ่ม อ่านเพิ่มเติม / ซ่อน -->
    <TextView
        android:id="@+id/toggleReadMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="อ่านเพิ่มเติม"
        android:textColor="@color/black"
        android:fontFamily="@font/mitrbold"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription"/>

    <!-- ส่วนเลื่อนของนักแสดงและผู้กำกับ -->

    <TextView
        android:id="@+id/castAndDirectorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/mitr"
        android:text="นักแสดงและผู้กำกับ"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription" />

    <HorizontalScrollView
        android:id="@+id/castAndDirectorScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/castAndDirectorTitle">

        <!-- LinearLayout ภายใน HorizontalScrollView เพื่อใส่ภาพนักแสดงและผู้กำกับ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/hsd"
                    android:contentDescription="Director 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ภาคภูมิ วงศ์ภูมิ (ผู้กำกับ)"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/hs1"
                    android:contentDescription="Actor 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ธีรดนย์ ศุภพันธุ์ภิญโญ"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/hs2"
                    android:contentDescription="Actor 2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="เฌอปราง อารีย์กุล"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/hs3"
                    android:contentDescription="Actor 3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="สู่ขวัญ บูลกุล"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/hs4"
                    android:contentDescription="Actor 4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="นพชัย ชัยนาม"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ปุ่ม "ออกจากโหมดเต็มจอ" -->
    <ImageButton
        android:id="@+id/exitFullScreenButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/baseline_crop_free_24"
        android:contentDescription="Exit Full Screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:visibility="gone" /> <!-- ซ่อนตอนแรก -->
</androidx.constraintlayout.widget.ConstraintLayout>

