<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/watchingRoot"
    android:animateLayoutChanges="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ปุ่มย้อนกลับ -->
    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/arrow_back"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>

    <!-- ส่วนของการเล่นวิดีโอ -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ปุ่ม "รับชมภาพยนตร์" -->
    <Button
        android:id="@+id/playButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="กดรับชมภาพยนตร์"
        android:backgroundTint="#9D161515"
        android:fontFamily="@font/mitr"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/videoView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- ข้อความใต้ปุ่ม "รับชมภาพยนตร์" -->
    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="หมุนโทรศัพท์ในแนวนอน ก่อนกดรับชม"
        android:fontFamily="@font/mitrbold"
        android:textColor="#000000"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="1dp"
        app:layout_constraintTop_toBottomOf="@id/playButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ชื่อภาพยนตร์ -->
    <TextView
        android:id="@+id/movieTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="อ้าย..คนหล่อลวง"
        android:textSize="24sp"
        android:fontFamily="@font/mitr"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/messageText"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- เรื่องย่อภาพยนตร์ -->

    <TextView
        android:id="@+id/movieDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/mitr"
        android:text="‘ทาวเวอร์’ นักต้มตุ๋นคอลเซนเตอร์สุดแพรวพราว ที่ดันพลาดท่าถูก ‘อินา’ (อดีตสาวแบงค์สุดเพี้ยนจับไต๋ได้ อินาจึงยื่นข้อเสนอเพื่อแลกกับการไม่แจ้งตำรวจจับ นั่นคือการให้ทาวเวอร์คิดแผนต้มตุ๋น ‘เพชร’ แฟนเด็กที่หลอกให้อินาเปย์ค่าเทอมหลายแสนแล้วชิ่งหนี จนอินาเป็นหนี้ท่วมหัว ภารกิจถูกยกระดับ เมื่อทาวเวอร์ตัดสินใจเปลี่ยนแผน จากต้มเงินแสน เป็นตุ๋นเงินล้าน งานนี้จึงต้องหาผู้ร่วมทีมอย่าง ‘ครูนงนุช’ ครูสมัยประถมของอินา ที่ต้องปลอมตัวเป็นนักธุรกิจสาว และ ‘พี่โจร’ (พี่ชายของทาวเวอร์ มิจฉาชีพรุ่นเก๋าที่เข้าออกคุกเป็นว่าเล่น เริ่มแผนลวงได้ไม่ทันไร อินากลับหวั่นไหวกับสิบแปดมงกุฎสุดหล่ออย่างทาวเวอร์ เหมือนชีวิตวนมาเจอแฟลชแบ็ก หรือจะเป็นโชคร้ายของอินา ที่ต้องเจอแต่ผู้ชาย 'หล่อลวง' ภารกิจหลอกเงินต้องเดินหน้า แต่อินาจะห้ามใจ ไม่ให้รักนักต้มตุ๋นไหวหรือเปล่า!"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieTitle" />

    <!-- ปุ่ม อ่านเพิ่มเติม / ซ่อน -->
    <TextView
        android:id="@+id/toggleReadMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="อ่านเพิ่มเติม"
        android:textColor="@color/black"
        android:fontFamily="@font/mitrbold"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription"/>

    <!-- ส่วนเลื่อนของนักแสดงและผู้กำกับ -->

    <TextView
        android:id="@+id/castAndDirectorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="50dp"
        android:fontFamily="@font/mitr"
        android:text="นักแสดงและผู้กำกับ"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/movieDescription" />

    <HorizontalScrollView
        android:id="@+id/castAndDirectorScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/castAndDirectorTitle">

        <!-- LinearLayout ภายใน HorizontalScrollView เพื่อใส่ภาพนักแสดงและผู้กำกับ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/cd"
                    android:contentDescription="Director 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="เมษ ธราธร (ผู้กำกับ)"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/c1"
                    android:contentDescription="Actor 1"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ณเดชน์ คูกิมิยะ"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/c2"
                    android:contentDescription="Actor 2"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="พิมพ์ชนก ลือวิเศษไพบูลย์"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/c3"
                    android:contentDescription="Actor 3"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ธิติ มหาโยธารักษ์"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/c4"
                    android:contentDescription="Actor 4"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="คัทลียา แมคอินทอช"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/c5"
                    android:contentDescription="Actor 5"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="พงศธร จงวิลาส"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ปุ่ม "ออกจากโหมดเต็มจอ" -->
    <ImageButton
        android:id="@+id/exitFullScreenButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/baseline_crop_free_24"
        android:contentDescription="Exit Full Screen"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:visibility="gone" /> <!-- ซ่อนตอนแรก -->
</androidx.constraintlayout.widget.ConstraintLayout>

