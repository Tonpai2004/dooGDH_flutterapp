<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainComingSoon">

    <!-- 🔒 Top Bar อยู่ติดบนตลอด -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="66dp"
        android:background="#85FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/backHome"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/arrow_back"
            android:contentDescription="Backhome"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 🔻 เนื้อหา Scrollable -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ด้านในเป็น Layout เดิม -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Space
                android:layout_width="match_parent"
                android:layout_height="82dp"
                app:layout_constraintTop_toBottomOf="@id/cardMovie4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />


            <!-- ข้อความหัวเรื่อง -->
        <TextView
            android:id="@+id/comingSoonTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="โปรแกรมภาพยนตร์เข้าใหม่ เร็วๆนี้"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/mitrbold"
            android:textColor="#2196F3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            tools:ignore="MissingConstraints" />

        <!-- กรอบแนะนำภาพยนตร์ 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovie1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/comingSoonTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- โปสเตอร์ภาพยนตร์ -->
                <ImageView
                    android:id="@+id/imagePoster1"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/theredenvelope" />

                <!-- ชื่อเรื่อง และวันที่ฉาย -->
                <TextView
                    android:id="@+id/textTitle1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ชองแดงแต่งผี"
                    android:fontFamily="@font/mitrbold"
                    android:textColor="#F44336"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textDateTime1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กำหนดสตรีม กรกฎาคมนี้"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:textColor="#666666" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- กรอบแนะนำภาพยนตร์ 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovie2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardMovie1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- โปสเตอร์ภาพยนตร์ -->
                <ImageView
                    android:id="@+id/imagePoster2"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/flatgirls" />

                <!-- ชื่อเรื่อง และวันที่ฉาย -->
                <TextView
                    android:id="@+id/textTitle2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FLAT GIRLS ชั้นห่างระหว่าง เ ร า"
                    android:fontFamily="@font/mitrbold"
                    android:textColor="#F44336"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textDateTime2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กำหนดสตรีม 8 พฤษภาคมนี้"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:textColor="#666666" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- กรอบแนะนำภาพยนตร์ 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovie3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardMovie2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- โปสเตอร์ภาพยนตร์ -->
                <ImageView
                    android:id="@+id/imagePoster3"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/shutter" />

                <!-- ชื่อเรื่อง และวันที่ฉาย -->
                <TextView
                    android:id="@+id/textTitle3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ชัตเตอร์ (REMASTERED 4K)"
                    android:fontFamily="@font/mitrbold"
                    android:textColor="#F44336"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textDateTime3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กำหนดสตรีม 18 มิถุนายนนี้"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:textColor="#666666" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- กรอบแนะนำภาพยนตร์ 4 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMovie4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:layout_constraintTop_toBottomOf="@id/cardMovie3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- โปสเตอร์ภาพยนตร์ -->
                <ImageView
                    android:id="@+id/imagePoster4"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ghostlab" />

                <!-- ชื่อเรื่อง และวันที่ฉาย -->
                <TextView
                    android:id="@+id/textTitle4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GHOST LAB ฉีกกฎ..ทดลองผี"
                    android:fontFamily="@font/mitrbold"
                    android:textColor="#F44336"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textDateTime4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="กำหนดสตรีม 18 มิถุนายนนี้"
                    android:fontFamily="@font/mitr"
                    android:textSize="14sp"
                    android:textColor="#666666" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>